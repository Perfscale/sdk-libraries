{
  "name": "@perfscale/library-sdk",
  "version": "0.3.0",
  "description": "TypeScript/JavaScript SDK for authoring perfscale WASM libraries and end-of-run reporters (RFC 005, issue #9)",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Perfscale/sdk-libraries.git",
    "directory": "ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "perfscale-library-build": "./bin/perfscale-library-build.mjs"
  },
  "files": [
    "dist",
    "bin",
    "wit"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "example:build": "node bin/perfscale-library-build.mjs examples/hello/hello.ts -o examples/hello/hello.wasm",
    "example:build:reporter": "node bin/perfscale-library-build.mjs --kind reporter examples/summary/summary.ts -o examples/summary/summary.wasm",
    "example:build:configlib": "node bin/perfscale-library-build.mjs examples/configlib/configlib.ts -o examples/configlib/configlib.wasm"
  },
  "dependencies": {
    "@bytecodealliance/jco": "^1.35.0",
    "@bytecodealliance/preview2-shim": "^0.25.0"
  },
  "overrides": {
    "@bytecodealliance/jco": {
      "@bytecodealliance/componentize-js": "^0.23.0"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
